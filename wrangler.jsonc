{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "documentation",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-29",
  "previews": {},
  "cache": {
    "enabled": true,
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": ["/docs", "/docs/*"],
  },
}
